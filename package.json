{
  "name": "office-automation",
  "version": "1.0.0",
  "description": "근로장학생 일지 자동화 웹 애플리케이션",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:cli": "node \"시간표.js\"",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "node scripts/ui-smoke.js",
    "test:calendar-ui": "node scripts/calendar-ui-smoke.js",
    "test:modal-ui": "node scripts/modal-ui-smoke.js",
    "test:interval-ui": "node scripts/interval-ui-smoke.js",
    "check:browser": "node scripts/check-browser.js",
    "check:macos": "npm run check:browser",
    "test:portal-live": "node scripts/live-web-query-smoke.js",
    "test:portal-login": "node scripts/live-http-login-smoke.js",
    "test:portal-dry-run": "node scripts/live-portal-dry-run.js",
    "inspect:portal-api": "node scripts/inspect-portal-api.js",
    "audit:security": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "readline-sync": "^1.4.10",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "puppeteer": "^25.9.0",
    "supertest": "^7.2.2"
  }
}

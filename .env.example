# Local defaults are safe for one PC. Set production values before exposing the app.
HOST=127.0.0.1
PORT=3210
NODE_ENV=development

# Production requires a 32-byte key encoded as base64 or 64 hex characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_MASTER_KEY=
# Docker may use APP_MASTER_KEY_FILE instead of APP_MASTER_KEY.

# Production only: protects the first administrator setup screen.
SETUP_TOKEN=
# Docker may use SETUP_TOKEN_FILE instead of SETUP_TOKEN.

# Set to true only behind HTTPS. Configure TRUST_PROXY when using a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# One HTTP job worker is the safest default for the school portal.
AUTOMATION_CONCURRENCY=1
# Shared request spacing across users; 429/503 pauses school requests.
PORTAL_REQUEST_INTERVAL_MS=500
# Legacy compatibility; the web portal client does not launch a browser.
AUTOMATION_HEADLESS=true
